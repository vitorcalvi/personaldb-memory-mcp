{
  "name": "personaldb-memory-mcp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Zero-config Cloudflare Access protected memory MCP using D1 FTS5 + Vectorize + RRF for ChatGPT, Ava Mobile, and My Thoughs",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "local:smoke": "node scripts/local-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "deploy": "wrangler deploy --env production",
    "plugin:source": "node scripts/build-source-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.26.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22"
  }
}
